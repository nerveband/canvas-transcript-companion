{
  "manifest_version": 3,
  "name": "Canvas Transcript Companion",
  "description": "Adds a synced, clickable transcript panel to Canvas video pages when captions are available.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.instructuremedia.com/*",
    "https://*.canvaslms.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://*.instructuremedia.com/*",
        "https://*.canvaslms.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/page-monitor.js"]
    },
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://*.instructuremedia.com/*",
        "https://*.canvaslms.com/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["src/content.js"],
      "css": ["src/content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
